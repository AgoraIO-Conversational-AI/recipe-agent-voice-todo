AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGENT_GREETING=Hi! I'm your todo assistant. Tell me to add, move, or finish tasks.
MCP_ENDPOINT=https://<your-tunnel>/mcp
OPENAI_MODEL=gpt-4o-mini
BOARD_DB_PATH=/tmp/board.db
# OPENAI_API_KEY is optional — Agora manages the OpenAI key (keyless).
# OPENAI_API_KEY=sk-your-openai-key
